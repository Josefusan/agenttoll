# Where the AgentToll gateway admin API listens (agenttoll.yaml: admin_listen).
AGENTTOLL_ADMIN_URL=http://127.0.0.1:8403

# Bearer token for /admin/*. Server-side only: the browser never sees it.
# Must match the gateway's AGENTTOLL_ADMIN_TOKEN. The fixture server accepts "fixture-token".
AGENTTOLL_ADMIN_TOKEN=change-me

# Optional. Where the "Cash out" card sends founders. Defaults to docs/PAYOUTS.md on GitHub.
# NEXT_PUBLIC_PAYOUTS_URL=https://github.com/Josefusan/agenttoll/blob/main/docs/PAYOUTS.md

# Optional. Public URL of the gateway, shown in the empty state's curl example.
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8402
