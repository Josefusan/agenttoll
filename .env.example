AGENTTOLL_SOLANA_PAYTO=
AGENTTOLL_BASE_PAYTO=
# Buyer demo wallet (devnet only). Path to a Solana keypair file, never commit it.
BUYER_SOLANA_KEYPAIR=./buyer.keypair.json
BUYER_MAX_USD_PER_CALL=0.01
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base Sepolia buyer (backup rail, testnet only). Hex private key.
BUYER_EVM_PRIVATE_KEY=
