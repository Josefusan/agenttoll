# Admin API for the dashboard (>= 24 chars). Unset = admin API off.
AGENTTOLL_ADMIN_TOKEN=
# Optional
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
DATABASE_URL=sqlite://agenttoll.db
