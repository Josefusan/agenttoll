# pay-mcp: wallet and caps for the buyer side. Devnet / testnet only.
BUYER_SOLANA_KEYPAIR=./buyer.keypair.json        # solana-keygen JSON byte array; never commit it
# BUYER_EVM_PRIVATE_KEY=0x...                      # optional Base Sepolia backup rail
PAY_MCP_NETWORK=solana                             # solana | base (preferred rail when the seller offers both)
SOLANA_RPC_URL=https://api.devnet.solana.com
BUYER_MAX_USD_PER_CALL=0.01
BUYER_MAX_USD_PER_DAY=0.25
# PAY_MCP_SPEND_FILE=~/.agenttoll/spend.json       # where today's spend is persisted
# PAY_MCP_MAX_BODY_BYTES=16384                     # response bodies longer than this are truncated
