[
  {
    "id": "BIND-01",
    "promise": "A payment for one blog post cannot be spent on another post of the same price (resource binding)",
    "steps": [
      {
        "id": "q",
        "request": {
          "path": "/blog/post-a",
          "agent": "GPTBot"
        },
        "expect": {
          "status": 402
        }
      },
      {
        "request": {
          "path": "/blog/post-b",
          "agent": "GPTBot"
        },
        "pay": {
          "from": "q"
        },
        "expect": {
          "status": 402,
          "json": {
            "/error": {
              "contains": "different resource"
            }
          },
          "headers": {
            "payment-response": {
              "absent": true
            }
          },
          "body_not_contains": "post-b</h1>"
        }
      }
    ]
  },
  {
