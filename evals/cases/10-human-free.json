[
  {
    "id": "HUM-01",
    "promise": "Chrome desktop gets 200 free on a paid route (GET /api/quote)",
    "steps": [
      {
        "request": {
          "path": "/api/quote",
          "agent": "human-chrome"
        },
        "expect": {
          "status": 200,
          "headers": {
            "payment-required": {
              "absent": true
            },
            "payment-response": {
              "absent": true
            }
          },
          "json": {
            "/paid": false,
            "/symbol": "SOL/USD"
          }
        }
      }
    ]
  },
