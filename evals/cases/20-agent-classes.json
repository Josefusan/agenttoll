[
  {
    "id": "AGT-01",
    "promise": "GPTBot gets 402 with an x402 v2 quote on a paid route",
    "steps": [
      {
        "request": {
          "path": "/api/quote",
          "agent": "GPTBot"
        },
        "expect": {
          "status": 402,
          "headers": {
            "payment-required": {
              "exists": true
            },
            "x-agenttoll-verdict": "ua:GPTBot",
            "content-type": {
              "re": "^application/json"
            }
          },
          "challenge": {
            "/x402Version": 2
          },
          "json": {
            "/x402Version": 2
          }
        }
      }
    ]
  },
