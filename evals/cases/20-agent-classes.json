  {
    "id": "AGT-06",
    "promise": "An MCP client (any UA) calling a paid tool gets the MCP-native challenge, classified by endpoint",
    "steps": [
      {
        "request": {
          "method": "POST",
          "path": "/mcp",
          "agent": "mcp-client",
          "json": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
              "name": "search_docs",
              "arguments": {
                "query": "x402"
              }
            }
          }
        },
        "expect": {
          "status": 200,
          "headers": {
            "x-agenttoll-verdict": "mcp-endpoint",
            "payment-required": {
              "exists": true
            }
          },
          "json": {
            "/result/isError": true
          }
        }
      }
    ]
  },
  {
    "id": "AGT-07",
    "promise": "A declared agent is charged on every priced route, including one the origin will fail (/api/fail)",
    "steps": [
      {
        "request": {
          "path": "/api/fail",
          "agent": "GPTBot"
        },
        "expect": {
          "status": 402,
          "challenge": {
            "/accepts/@solana/amount": "1000"
          }
        }
      }
    ]
  },
  {
    "id": "AGT-08",
    "promise": "A declared agent on a free route (/) is passed through, not charged",
    "steps": [
      {
        "request": {
          "path": "/",
          "agent": "ClaudeBot"
        },
        "expect": {
          "status": 200,
          "headers": {
            "payment-required": {
              "absent": true
            }
          },
          "body_contains": "Acme Data"
        }
      }
    ]
  },
  {
    "id": "AGT-09",
