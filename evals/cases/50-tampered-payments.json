  },
  {
    "id": "TAMPER-12",
    "promise": "The v1 X-PAYMENT header is not accepted: 402 telling the client to use PAYMENT-SIGNATURE",
    "steps": [
      {
        "request": {
          "path": "/api/quote",
          "agent": "GPTBot",
          "headers": {
            "X-PAYMENT": "eyJ4NDAyVmVyc2lvbiI6MX0="
