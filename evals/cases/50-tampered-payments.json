  {
    "id": "TAMPER-09",
    "promise": "A payment without `accepted` requirements is a 400, not a charge",
    "steps": [
      {
        "id": "q",
        "request": {
          "path": "/api/quote",
          "agent": "GPTBot"
        },
        "expect": {
          "status": 402
        }
      },
      {
        "request": {
          "path": "/api/quote",
          "agent": "GPTBot"
        },
        "pay": {
          "from": "q",
          "drop": [
            "accepted"
          ]
        },
        "expect": {
          "status": 400,
          "headers": {
            "payment-response": {
              "absent": true
            }
          },
          "body_not_contains": "SOL/USD"
        }
      }
    ]
  },
