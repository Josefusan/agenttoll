[
  {
    "id": "TAMPER-01",
    "promise": "Tampered amount (2000 -> 1) is refused: the gateway compares against its own quote",
    "steps": [
      {
        "id": "q",
        "request": {
          "path": "/api/quote",
          "agent": "GPTBot"
        },
        "expect": {
          "status": 402
        }
      },
      {
        "request": {
          "path": "/api/quote",
          "agent": "GPTBot"
        },
        "pay": {
          "from": "q",
          "tamper": {
            "amount": "1"
          }
        },
        "expect": {
          "status": 402,
          "headers": {
            "payment-response": {
              "absent": true
            }
          },
          "body_not_contains": "SOL/USD",
          "json": {
            "/x402Version": 2,
            "/error": {
              "contains": "price quote"
            }
          }
        }
      }
    ]
  },
